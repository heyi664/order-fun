# Copy this file to deploy/.env on the server, then replace every CHANGE_ME value.
MYSQL_ROOT_PASSWORD=CHANGE_ME_GENERATE_A_LONG_RANDOM_PASSWORD
MYSQL_DATABASE=hycomment
MYSQL_APP_USER=heyee
MYSQL_APP_PASSWORD=CHANGE_ME_GENERATE_A_DIFFERENT_PASSWORD

REDIS_PASSWORD=CHANGE_ME_GENERATE_A_DIFFERENT_PASSWORD

# Java service resource limit for a 4 GB test server.
APP_JAVA_OPTS=-Xms256m -Xmx512m -XX:MaxMetaspaceSize=160m
# Use DEBUG only for short-lived troubleshooting; INFO is the production default.
LOG_LEVEL_COM_HEYEE=INFO

# Configure a usable SMTP account before testing email verification login.
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=your-sender@example.com
MAIL_PASSWORD=CHANGE_ME_SMTP_AUTHORIZATION_CODE
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=false
MAIL_SMTP_SSL_ENABLE=true
MAIL_FROM=your-sender@example.com

# Python Agent is a separate project. Once it is started in this Compose network,
# use http://agent:8000. Until then the rest of the application can still run.
AGENT_SERVICE_URL=http://agent:8000
AGENT_CONNECT_TIMEOUT=3000
AGENT_READ_TIMEOUT=90000

# Keep these private. They are needed by admin registration and MCP integration.
MCP_SERVER_TOKEN=CHANGE_ME_GENERATE_A_LONG_RANDOM_TOKEN
MCP_ALLOW_ANONYMOUS=false
ADMIN_BOOTSTRAP_REGISTER_CODE=CHANGE_ME_GENERATE_A_PRIVATE_CODE
